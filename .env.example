# Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./triage.db

# LLM Configuration
# Set LLM_PROVIDER to "mock" for offline deterministic testing and local demo without keys
# Set LLM_PROVIDER to "openai" (or any OpenAI-compatible API) with a valid key
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Streamlit Dashboard
BACKEND_API_URL=http://localhost:8000
